# EVIQ environment variables. Full explanations: env/README.md
# Local development: copy this file to .env.local in the repo root (it is git-ignored).
# Production: set the same names in Vercel (Project Settings -> Environment Variables).
# Never commit a file that contains real values.

# --- Charger data -------------------------------------------------------------------------
# Optional. Open Charge Map API key. Without it the app uses OpenStreetMap (worldwide, no key).
# Server-only: never prefix with NEXT_PUBLIC_.
OCM_API_KEY=

# --- Driver report storage (Supabase) -----------------------------------------------------
# Optional for local dev (reports then live in memory and are lost on restart).
# Required in production if reports must persist. Set both or neither.
SUPABASE_URL=
# Server-only. This key bypasses row level security: treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse protection ---------------------------------------------------------------------
# Recommended in production. A long random string (for example: openssl rand -hex 32).
# Used to hash client identifiers. Changing it resets every cooldown.
REPORT_HASH_SALT=

# --- Public ------------------------------------------------------------------------------
# Optional. Canonical site URL for metadata, sitemap and robots. Defaults to https://eviq.ai.
NEXT_PUBLIC_SITE_URL=
